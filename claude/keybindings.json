{
  "$schema": "https://www.schemastore.org/claude-code-keybindings.json",
  "$docs": "https://code.claude.com/docs/en/keybindings",
  "bindings": [
    {
      "context": "Chat",
      "bindings": {
        "ctrl+x t": "command:terminal",
        "ctrl+x s": "command:sessions"
      }
    },
    {
      "context": "Global",
      "bindings": {
        "ctrl+x ]": "pane:next",
        "ctrl+x [": "pane:previous"
      }
    }
  ]
}
